# ========================================================
# TRENRO CONFIGURATION (.env.example)
# Copy this file to .env.local and configure your credentials
# DO NOT commit real secrets, private keys, or credentials to git
# ========================================================

# Supabase Project URL & Anonymous Key (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose to frontend; used only in server-side routes and admin provisioning)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode configuration (Set to false in production)
NEXT_PUBLIC_DEMO_MODE=false

# ========================================================
# CLIENT CONCIERGE CONTACT INFORMATION
# ========================================================
NEXT_PUBLIC_CUSTOMER_CARE_EMAIL=rasu29906@gmail.com

# ========================================================
# RAZORPAY / UPI PAYMENT GATEWAY CONFIGURATION
# Generate keys from: https://dashboard.razorpay.com/app/keys
# ========================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
